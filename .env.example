# Bing Webmaster Tools API Configuration
# Get your API key from: https://www.bing.com/webmasters/configure/apikey
#
# Required for stdio transport, and for HTTP transport unless you're running
# a pure multi-tenant deployment (BWT_TENANTS set, no MCP_AUTH_TOKEN).
BING_WEBMASTER_API_KEY=your_api_key_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# --- Read-only gate ---------------------------------------------------------
# Default true: mutating tools (submit_url, add_site, remove_sitemap, etc.)
# are not registered at all -- tools/list won't show them. Set to "false" to
# register all 60 tools, including the 26 that mutate state on Bing's side.
# Only false/0/no (case-insensitive) disables read-only; anything else,
# including unset, stays read-only.
BWT_READ_ONLY=true

# --- Site allowlist ----------------------------------------------------------
# Comma-separated list of allowed site origins. Empty/unset = allow all sites
# (default). Enforced centrally before any Bing API call -- a site outside
# this list is rejected regardless of which tool is used.
# BWT_ALLOWED_SITES=https://example.com,https://client-two.com

# --- Transport ---------------------------------------------------------------
# stdio (default) for local/Desktop use, or http for a hosted deployment.
# MCP_TRANSPORT=stdio
# HTTP-only: port to bind (always 0.0.0.0). Default 8080.
# PORT=8080

# --- HTTP auth (required when MCP_TRANSPORT=http) ---------------------------
# Single static bearer token. Falls through to the global
# BING_WEBMASTER_API_KEY + BWT_ALLOWED_SITES above.
# MCP_AUTH_TOKEN=change_me_to_a_long_random_token

# Multi-tenant routing: JSON object mapping bearer token -> per-client API
# key + allowlist. One shared deployment can serve several client sites, each
# under its own Bing Webmaster account, with the API key bound to the
# authenticated token rather than looked up per tool call (some tools, like
# get_sites and add_site, have no existing site to route on). If a token
# isn't in this map, MCP_AUTH_TOKEN (if set) is checked as a fallback,
# unscoped admin-style token. At least one of MCP_AUTH_TOKEN / BWT_TENANTS
# must be set for HTTP transport to start.
# BWT_TENANTS={"tok_client1":{"api_key":"KEY1","allowed_sites":["https://client1.com"]},"tok_client2":{"api_key":"KEY2","allowed_sites":["https://client2.com"]}}
